# Frontend (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Supabase service role key, GROQ_API_KEY and DATAGOV_API_KEY are never
# used here. They are set as Supabase Edge Function secrets only:
#   supabase secrets set GROQ_API_KEY=...
#   supabase secrets set DATAGOV_API_KEY=...
